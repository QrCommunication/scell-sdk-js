{
  "name": "@scell/sdk",
  "version": "3.5.3",
  "description": "Official TypeScript SDK for Scell.io - Electronic invoicing (Factur-X) and signatures (eIDAS) API",
  "author": "Scell.io <contact@scell.io>",
  "license": "MIT",
  "keywords": [
    "scell",
    "invoicing",
    "factur-x",
    "electronic-signature",
    "eidas",
    "api",
    "sdk",
    "typescript",
    "billing",
    "e-invoicing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QrCommunication/scell-sdk-js.git"
  },
  "homepage": "https://scell.io",
  "bugs": {
    "url": "https://github.com/QrCommunication/scell-sdk-js/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "esbuild": ">=0.28.1",
    "vite": ">=8.0.16",
    "js-yaml": ">=4.2.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
